<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#153452" android:endColor="#0B1E31" android:angle="0" />
            <stroke android:width="3dp" android:color="#20C8FF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#10263C" android:endColor="#0A1726" android:angle="0" />
            <stroke android:width="1dp" android:color="#25415E" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
