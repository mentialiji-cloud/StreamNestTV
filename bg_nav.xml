<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#0B9CFF" android:endColor="#073B72" android:angle="0" />
            <stroke android:width="2dp" android:color="#15B8FF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#071827" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
